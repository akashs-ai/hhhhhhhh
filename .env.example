# =============================================================================
# CIT Campus Scheduling Platform — Environment Variables
# =============================================================================

# Server Network Configuration (Local Development)
HOST=0.0.0.0
PORT=3000

# Storage Driver: 'json' (default local development) or 'postgres' (required for persistent Vercel production)
STORAGE_DRIVER=json

# PostgreSQL Database URL (required when STORAGE_DRIVER=postgres)
# Example: postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres?sslmode=require
DATABASE_URL=
STAGING_DATABASE_URL=
PG_MAX_POOL=5

# Supabase Configuration (Optional Managed PostgreSQL & Auth)
SUPABASE_URL=
SUPABASE_ANON_KEY=
# SERVER-SIDE ONLY: Service role key for administrative provisioning (NEVER expose to frontend)
SUPABASE_SERVICE_ROLE_KEY=

# Google Workspace / OAuth 2.0 Integration
# Public Web Client ID (Frontend & GIS OAuth for Student authentication)
VITE_GOOGLE_CLIENT_ID=
# Server-only OAuth Client Secret (Optional for server-side token exchange)
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://hhhhh-gpz7.vercel.app/api/auth/callback/google

# Initial Account Provisioning Configuration
PROVISION_ADMIN_EMAIL=dean.academics@cit.ac.in

# Production Application Origin & Security
APP_URL=https://hhhhh-gpz7.vercel.app
NODE_ENV=production
ENABLE_DEMO_AUTH=false

# Python Scheduling Solver & Validator
# For local development: path to python binary (defaults to 'python' on Windows, '/usr/bin/python3' on Linux)
PYTHON_EXEC=

# For Vercel Serverless production: URL of decoupled Python solver microservice (running solver_service.py)
# Example: https://cit-solver.onrender.com
SOLVER_SERVICE_URL=
# Shared secret token for authenticating calls to the solver microservice
SOLVER_API_SECRET=

# AI Assistant (Google Gemini)
GEMINI_API_KEY=
